<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12100E"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStyleLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KULI VINILO · Todos"
            android:textColor="#E8C27A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOrganize"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="#2D241C"
            android:text="📥 Organizar Descargas"
            android:textColor="#FFD584"
            android:textSize="12sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/styleScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/styleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <com.kuli.vinilo.VinylTurntableView
        android:id="@+id/vinylView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvTrackTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Sin pista seleccionada"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTrackArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Kuli Music Hi-Fi"
        android:textColor="#B8A99A"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTimeCurrent"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#C9B8A3"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="#E8C27A"
            android:thumbTint="#FFD584" />

        <TextView
            android:id="@+id/tvTimeTotal"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="00:00"
            android:textColor="#C9B8A3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Aleatorio"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="#C9B8A3" />

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Anterior"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="#E8C27A"
            android:contentDescription="Play o Pausa"
            android:src="@android:drawable/ic_media_play"
            android:tint="#12100E" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Siguiente"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Repetir"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="#C9B8A3" />
    </LinearLayout>
</LinearLayout>

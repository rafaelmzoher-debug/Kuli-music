<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A0F07"
    android:keepScreenOn="true">

    <HorizontalScrollView
        android:id="@+id/styleScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2B1B0E"
        android:scrollbars="none"
        android:padding="6dp">
        <LinearLayout
            android:id="@+id/styleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvStyleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estilo: Varios"
        android:textColor="#F5E6C8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="4dp"
        android:background="#2B1B0E" />

    <com.kuli.vinilo.VinylTurntableView
        android:id="@+id/vinylView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="200dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2B1B0E"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin pista"
            android:textColor="#F5E6C8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center" />
        <TextView
            android:id="@+id/tvTrackArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#C9A227"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:background="#2B1B0E">
        <TextView
            android:id="@+id/tvTimeCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#F5E6C8"
            android:textSize="12sp"
            android:fontFamily="monospace" />
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#C9A227"
            android:thumbTint="#F5E6C8" />
        <TextView
            android:id="@+id/tvTimeTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#F5E6C8"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#2B1B0E"
        android:padding="6dp">
        <Button android:id="@+id/btnShuffle" android:layout_width="48dp" android:layout_height="48dp" android:text="🔀" android:textColor="#F5E6C8" android:backgroundTint="#3D2614" />
        <Button android:id="@+id/btnPrev" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="6dp" android:text="⏮" android:textSize="18sp" android:textColor="#F5E6C8" android:backgroundTint="#3D2614" />
        <Button android:id="@+id/btnPlayPause" android:layout_width="68dp" android:layout_height="68dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="▶" android:textSize="22sp" android:textColor="#1A0F07" android:backgroundTint="#C9A227" />
        <Button android:id="@+id/btnNext" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="6dp" android:text="⏭" android:textSize="18sp" android:textColor="#F5E6C8" android:backgroundTint="#3D2614" />
        <Button android:id="@+id/btnRepeat" android:layout_width="48dp" android:layout_height="48dp" android:text="🔁" android:textColor="#F5E6C8" android:backgroundTint="#3D2614" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#1A0F07"
        android:padding="6dp">
        <Button android:id="@+id/btnTrackList" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="☰ Lista de pistas" android:textColor="#F5E6C8" android:backgroundTint="#2B1B0E" />
        <Button android:id="@+id/btnOrganize" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="📥 Organizar" android:textColor="#C9A227" android:backgroundTint="#2B1B0E" />
    </LinearLayout>
</LinearLayout>
